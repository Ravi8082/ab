# Copy to .env and fill locally. Never commit .env.
# Local development can use root/root; create a dedicated strong-password
# MySQL user before going live and grant it only the needed tables.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=ar

API_PORT=4000
PUBLIC_SITE_URL=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Load / scaling knobs. Keep TRUST_PROXY=1 behind one reverse proxy.
TRUST_PROXY=1
DB_POOL_SIZE=20
WEB_CONCURRENCY=1
PAGE_CACHE_MS=10000
REMINDERS_ENABLED=true
REMINDER_INTERVAL_MS=300000

# Used only by the first-run seed; the database stores a bcrypt hash.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Expo Admin

# Keep true for local development; set both to false once integrations are live.
OTP_DEV_MODE=true
PAYMENT_DEV_MODE=true

# SMTP — Gmail requires a Google App Password (2-Step Verification must be on).
# Never use the normal Gmail account password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=Adhyatmik Bharat <your-sender@gmail.com>
SUPPORT_EMAIL=your-sender@gmail.com

# Razorpay — required when PAYMENT_DEV_MODE=false.
# Webhook URL: https://your-domain.com/api/payments/razorpay/webhook
# Subscribe to payment.captured and order.paid.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
