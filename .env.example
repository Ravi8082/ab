# Copy to .env and fill locally. Never commit .env.
# Local development can use root/root; create a dedicated strong-password
# MySQL user before going live and grant it only the needed tables.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=ar

API_PORT=4000
# Production: the real HTTPS origin of the site, e.g. https://adhyatmikbharat.example
PUBLIC_SITE_URL=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters — production refuses to boot with the example value.
JWT_SECRET=replace-with-a-long-random-secret
# Extra browser origins allowed to call the API with credentials, comma-separated.
# Local dev origins (localhost:5173/4000) are allowed automatically outside production.
CORS_ORIGINS=

# How many proxies sit in front of the API. Use 1 behind nginx, or the number of hops.
# Set false (or 0) if the API is exposed directly — then forwarded headers are ignored
# and rate limiting / audit logs use the real socket address instead of a spoofable one.
TRUST_PROXY=1
DB_POOL_SIZE=20
WEB_CONCURRENCY=1
PAGE_CACHE_MS=10000
REMINDERS_ENABLED=true
REMINDER_INTERVAL_MS=300000

# Used only by the first-run seed; the database stores a bcrypt hash.
# Admin passwords need at least 10 characters with upper case, lower case and a number.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Expo Admin

# Keep true for local development. With NODE_ENV=production the API refuses to start
# while either is still true, so payments and OTP emails cannot be silently simulated.
OTP_DEV_MODE=true
PAYMENT_DEV_MODE=true

# SMTP — Gmail requires a Google App Password (2-Step Verification must be on).
# Never use the normal Gmail account password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=Adhyatmik Bharat <your-sender@gmail.com>
SUPPORT_EMAIL=your-sender@gmail.com

# Social profiles — used in pass emails and the PDF footer.
# Leave blank until the real profile exists; placeholder values that point back
# at the event site are ignored automatically.
SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=
SOCIAL_YOUTUBE=
SOCIAL_LINKEDIN=

# Razorpay — required when PAYMENT_DEV_MODE=false.
# Webhook URL: https://your-domain.com/api/payments/razorpay/webhook
# Subscribe to payment.captured and order.paid.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
